{
  "name": "tenno-companion",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "check-updates": "turbo run check-updates",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "fetch-data": "turbo run fetch-data",
    "test": "turbo run test",
    "docker:build": "docker compose -f compose.dev.yaml up --build ",
    "docker:dev": "docker compose -f compose.dev.yaml up --build ",
    "docker:start": "docker compose up",
    "docker:push": "docker buildx build --file apps/web/Dockerfile --build-arg STANDALONE=true -t git.mateoleal.com/mateoleal/tennocompanion:$(node -p \"require('./apps/web/package.json').version\") -t git.mateoleal.com/mateoleal/tennocompanion:latest --push ."
  },
  "dependencies": {
    "@changesets/cli": "^2.30.0"
  },
  "devDependencies": {
    "turbo": "^2.10.5"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "packageManager": "pnpm@12.6.0"
}
